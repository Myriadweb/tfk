{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Teammates For Kids",
  "version": "2.1.0",
  "identifier": "com.teammates-for-kids",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Teammates For Kids",
        "resizable": false,
        "fullscreen": true,
        "decorations": false,
        "skipTaskbar": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
