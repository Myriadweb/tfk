{
  "name": "teammates",
  "author": "Myriad",
  "version": "2.0.2",
  "private": true,
  "main": "main.js",
  "type": "module",
  "engines": {
    "node": "^16.15.1",
    "npm": "^8.11.0"
  },
  "homepage": "./",
  "build": {
    "appId": "Myriad.TeammatesForKids",
    "productName": "Teammates for Kids",
    "files": [
      "./build/**/*",
      "./main.js",
      "package.json"
    ],
    "extends": null,
    "mac": {
      "category": "public.app-category.education",
      "type": "development"
    }
  },
  "dependencies": {
    "@inlet/react-pixi": "^6.8.0",
    "concurrently": "^7.2.2",
    "electron-is": "^3.0.0",
    "i18next": "^21.8.11",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-draggable": "^4.4.5",
    "react-i18next": "^11.17.4",
    "react-player": "^2.11.0",
    "react-router-dom": "^6.3.0",
    "react-scripts": "^5.0.1",
    "react-slider": "^2.0.3",
    "react-spring": "^9.4.5",
    "typescript": "^4.7.4",
    "use-sound": "^4.0.1"
  },
  "scripts": {
    "electron:dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "start": "craco start",
    "build": "craco build",
    "predeploy": "npm run build",
    "deploy": "npm run build && gh-pages -d build",
    "build-electron": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\" --color",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,jsx}\" --color --fix",
    "format": "prettier --write src/**/*.{ts,tsx,css} --ignore-unknown",
    "prepare": "husky install",
    "typecheck": "tsc --noEmit",
    "precommit": "npm run lint:fix && npm run typecheck && npm run format",
    "electron:build": "npm run build-electron && electron-builder build --publish never -wm",
    "electron:build:windows": "npm run build-electron && electron-builder build --publish never -w",
    "electron:build:no-scripts": "electron-builder build --publish never -wm",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "eslintConfig": {
    "plugins": [
      "prettier"
    ],
    "extends": [
      "eslint:recommended",
      "prettier",
      "extends"
    ],
    "rules": {
      "no-console": 1,
      "prettier/prettier": 2
    }
  },
  "browserslist": {
    "production": [
      "last 1 chrome version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.2",
    "@commitlint/config-conventional": "^17.0.2",
    "@craco/craco": "^7.1.0",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/react": "^12.0.0",
    "@testing-library/user-event": "^12.0.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.11.41",
    "@types/react": "^18.0.14",
    "@types/react-dom": "^18.0.5",
    "@types/react-slider": "^1.3.1",
    "@types/webpack-env": "^1.18.0",
    "@typescript-eslint/eslint-plugin": "^5.29.0",
    "@typescript-eslint/parser": "^5.29.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.0.12",
    "eslint": "^8.18.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-jest": "^26.5.3",
    "eslint-plugin-prettier": "4.0.0",
    "eslint-plugin-react": "^7.30.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "gh-pages": "^6.3.0",
    "husky": "^8.0.1",
    "prettier": "^2.7.1",
    "prettier-eslint": "^15.0.1",
    "prettier-eslint-cli": "6.0.1",
    "wait-on": "^6.0.1",
    "workbox-webpack-plugin": "^7.3.0"
  }
}
